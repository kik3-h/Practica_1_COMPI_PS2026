package com.compiladores.practica1.generated;

import java_cup.runtime.*;
import com.compiladores.practica1.ast.*;
import com.compiladores.practica1.reports.*;
import java.util.*;

/* ═══════════════════════════════════════════════════════════
   CUP Parser – Practica 1 Compiladores
   ═══════════════════════════════════════════════════════════ */

parser code {:
    private List<ErrorReport> errors = new ArrayList<>();

    public List<ErrorReport> getErrors() { return errors; }

    @Override
    public void report_error(String message, Object info) {
        if (info instanceof Symbol) {
            Symbol s = (Symbol) info;
            errors.add(new ErrorReport(
                s.value != null ? s.value.toString() : "?",
                s.left, s.right,
                "Sintáctico", message));
        } else {
            errors.add(new ErrorReport("?", 0, 0, "Sintáctico", message));
        }
    }

    @Override
    public void report_fatal_error(String message, Object info) {
        report_error(message, info);
    }
:};

/* ── Terminal symbols ── */
terminal            INICIO, FIN, VAR, SI, ENTONCES, FINSI;
terminal            MIENTRAS, HACER, FINMIENTRAS, MOSTRAR, LEER;
terminal            PLUS, MINUS, TIMES, DIVIDE;
terminal            EQ, NEQ, GT, LT, GTE, LTE;
terminal            AND, OR, NOT;
terminal            ASSIGN, LPAREN, RPAREN;
terminal            SEPARATOR;
terminal            PIPE, COMMA;
terminal	        UMINUS;

/* Config instruction terminals */
terminal CFG_DEFAULT, CFG_COLOR_TEXTO_SI, CFG_COLOR_SI;
terminal CFG_FIGURA_SI, CFG_LETRA_SI, CFG_LETRA_SIZE_SI;
terminal CFG_COLOR_TEXTO_MIENTRAS, CFG_COLOR_MIENTRAS;
terminal CFG_FIGURA_MIENTRAS, CFG_LETRA_MIENTRAS, CFG_LETRA_SIZE_MIENTRAS;
terminal CFG_COLOR_TEXTO_BLOQUE, CFG_COLOR_BLOQUE;
terminal CFG_FIGURA_BLOQUE, CFG_LETRA_BLOQUE, CFG_LETRA_SIZE_BLOQUE;

terminal String  ID, STRING, FIGURA_NAME, LETRA_NAME, HEX_COLOR;
terminal Integer INTEGER;
terminal Double  DECIMAL;

/* ── Non-terminals ── */
non terminal ProgramNode          program;
non terminal AlgoSection          algo_section;
non terminal ConfigSection        config_section;
non terminal List<StmtNode>       stmt_list;
non terminal StmtNode             stmt;
non terminal List<StmtNode>       block;
non terminal List<StmtNode>       block_list;
non terminal StmtNode             block_stmt;
non terminal VarDeclNode          var_decl;
non terminal AssignNode           assignment;
non terminal IfNode               if_stmt;
non terminal WhileNode            while_stmt;
non terminal ShowNode             show_stmt;
non terminal ReadNode             read_stmt;
non terminal ExprNode             expr, term, factor;
non terminal CondNode             condition;
non terminal List<ConfigInstr>    config_list;
non terminal ConfigInstr          config_instr;
non terminal ColorValue           color_value;
non terminal Double               num_expr, num_term, num_factor;

/* ── Precedence ── */
precedence left OR;
precedence left AND;
precedence right NOT;
precedence left PLUS, MINUS;
precedence left TIMES, DIVIDE;
precedence right UMINUS;

/* ═══════════════════════════════════════════
   Start
   ═══════════════════════════════════════════ */
start with program;

program ::= algo_section:a SEPARATOR config_section:c
            {: RESULT = new ProgramNode(a, c); :}
          ;

/* ═══════════════════════════════════════════
   Algorithm Section
   ═══════════════════════════════════════════ */
algo_section ::= INICIO stmt_list:sl FIN
                 {: RESULT = new AlgoSection(sl); :}
               ;

stmt_list ::= stmt_list:sl stmt:s
              {: sl.add(s); RESULT = sl; :}
            | stmt:s
              {: List<StmtNode> l = new ArrayList<>(); l.add(s); RESULT = l; :}
            ;

stmt ::= var_decl:v    {: RESULT = v; :}
       | assignment:a  {: RESULT = a; :}
       | if_stmt:i     {: RESULT = i; :}
       | while_stmt:w  {: RESULT = w; :}
       | show_stmt:s   {: RESULT = s; :}
       | read_stmt:r   {: RESULT = r; :}
       ;

/* Variable declaration */
var_decl ::= VAR ID:id
             {: RESULT = new VarDeclNode(id, null, idleft, idright); :}
           | VAR ID:id ASSIGN expr:e
             {: RESULT = new VarDeclNode(id, e, idleft, idright); :}
           ;

/* Assignment */
assignment ::= ID:id ASSIGN expr:e
               {: RESULT = new AssignNode(id, e, idleft, idright); :}
             ;

/* If – both FINSI and FIN SI */
if_stmt ::= SI:s LPAREN condition:c RPAREN ENTONCES block:b FINSI
            {: RESULT = new IfNode(c, b, sleft, sright); :}
          | SI:s LPAREN condition:c RPAREN ENTONCES block:b FIN SI
            {: RESULT = new IfNode(c, b, sleft, sright); :}
          ;

/* While – both FINMIENTRAS and FIN MIENTRAS */
while_stmt ::= MIENTRAS:m LPAREN condition:c RPAREN HACER block:b FINMIENTRAS
               {: RESULT = new WhileNode(c, b, mleft, mright); :}
             | MIENTRAS:m LPAREN condition:c RPAREN HACER block:b FIN MIENTRAS
               {: RESULT = new WhileNode(c, b, mleft, mright); :}
             ;

/* Block: only VAR, assignment, MOSTRAR, LEER */
block ::= block_list:bl {: RESULT = bl; :}
        ;

block_list ::= block_list:bl block_stmt:s
               {: bl.add(s); RESULT = bl; :}
             | block_stmt:s
               {: List<StmtNode> l = new ArrayList<>(); l.add(s); RESULT = l; :}
             ;

block_stmt ::= var_decl:v   {: RESULT = v; :}
             | assignment:a {: RESULT = a; :}
             | show_stmt:s  {: RESULT = s; :}
             | read_stmt:r  {: RESULT = r; :}
             ;

/* Show */
show_stmt ::= MOSTRAR:m STRING:s
              {: RESULT = new ShowNode(new StringLiteralNode(s, mleft, mright), mleft, mright); :}
            | MOSTRAR:m expr:e
              {: RESULT = new ShowNode(e, mleft, mright); :}
            ;

/* Read */
read_stmt ::= LEER:l ID:id
              {: RESULT = new ReadNode(id, lleft, lright); :}
            ;

/* ═══════════════════════════════════════════
   Conditions
   ═══════════════════════════════════════════ */
condition ::= expr:l EQ:op  expr:r  {: RESULT = new RelOpNode("==", l, r, opleft, opright); :}
            | expr:l NEQ:op expr:r  {: RESULT = new RelOpNode("!=", l, r, opleft, opright); :}
            | expr:l GT:op  expr:r  {: RESULT = new RelOpNode(">",  l, r, opleft, opright); :}
            | expr:l LT:op  expr:r  {: RESULT = new RelOpNode("<",  l, r, opleft, opright); :}
            | expr:l GTE:op expr:r  {: RESULT = new RelOpNode(">=", l, r, opleft, opright); :}
            | expr:l LTE:op expr:r  {: RESULT = new RelOpNode("<=", l, r, opleft, opright); :}
            | condition:l AND:op condition:r {: RESULT = new LogOpNode("&&", l, r, opleft, opright); :}
            | condition:l OR:op  condition:r {: RESULT = new LogOpNode("||", l, r, opleft, opright); :}
            | NOT:op condition:c  {: RESULT = new NotNode(c, opleft, opright); :}
            | LPAREN condition:c RPAREN {: RESULT = c; :}
            ;

/* ═══════════════════════════════════════════
   Arithmetic expressions
   ═══════════════════════════════════════════ */
expr ::= expr:l PLUS:op  term:r  {: RESULT = new BinOpNode("+", l, r, opleft, opright); :}
       | expr:l MINUS:op term:r  {: RESULT = new BinOpNode("-", l, r, opleft, opright); :}
       | term:t                  {: RESULT = t; :}
       ;

term ::= term:l TIMES:op  factor:r  {: RESULT = new BinOpNode("*", l, r, opleft, opright); :}
       | term:l DIVIDE:op factor:r  {: RESULT = new BinOpNode("/", l, r, opleft, opright); :}
       | factor:f                   {: RESULT = f; :}
       ;

factor ::= INTEGER:n           {: RESULT = new IntLiteralNode(n, nleft, nright); :}
         | DECIMAL:n           {: RESULT = new DecLiteralNode(n, nleft, nright); :}
         | ID:id               {: RESULT = new IdNode(id, idleft, idright); :}
         | LPAREN expr:e RPAREN {: RESULT = e; :}
         | MINUS:m factor:f    {: RESULT = new NegNode(f, mleft, mright); :} %prec UMINUS
         ;

/* ═══════════════════════════════════════════
   Config Section
   ═══════════════════════════════════════════ */
config_section ::= config_list:cl {: RESULT = new ConfigSection(cl); :}
                 ;

config_list ::= config_list:cl config_instr:ci
                {: cl.add(ci); RESULT = cl; :}
              | config_instr:ci
                {: List<ConfigInstr> l = new ArrayList<>(); l.add(ci); RESULT = l; :}
              ;

config_instr ::=
    CFG_DEFAULT:c ASSIGN num_expr:idx
    {: RESULT = new ConfigInstr("DEFAULT", null, idx.intValue(), cleft, cright); :}

  | CFG_COLOR_TEXTO_SI:c ASSIGN color_value:col PIPE num_expr:idx
    {: RESULT = new ConfigInstr("COLOR_TEXTO_SI", col, idx.intValue(), cleft, cright); :}

  | CFG_COLOR_SI:c ASSIGN color_value:col PIPE num_expr:idx
    {: RESULT = new ConfigInstr("COLOR_SI", col, idx.intValue(), cleft, cright); :}

  | CFG_FIGURA_SI:c ASSIGN FIGURA_NAME:f PIPE num_expr:idx
    {: RESULT = new ConfigInstr("FIGURA_SI", f, idx.intValue(), cleft, cright); :}

  | CFG_LETRA_SI:c ASSIGN LETRA_NAME:l PIPE num_expr:idx
    {: RESULT = new ConfigInstr("LETRA_SI", l, idx.intValue(), cleft, cright); :}

  | CFG_LETRA_SIZE_SI:c ASSIGN num_expr:v PIPE num_expr:idx
    {: RESULT = new ConfigInstr("LETRA_SIZE_SI", v, idx.intValue(), cleft, cright); :}

  | CFG_COLOR_TEXTO_MIENTRAS:c ASSIGN color_value:col PIPE num_expr:idx
    {: RESULT = new ConfigInstr("COLOR_TEXTO_MIENTRAS", col, idx.intValue(), cleft, cright); :}

  | CFG_COLOR_MIENTRAS:c ASSIGN color_value:col PIPE num_expr:idx
    {: RESULT = new ConfigInstr("COLOR_MIENTRAS", col, idx.intValue(), cleft, cright); :}

  | CFG_FIGURA_MIENTRAS:c ASSIGN FIGURA_NAME:f PIPE num_expr:idx
    {: RESULT = new ConfigInstr("FIGURA_MIENTRAS", f, idx.intValue(), cleft, cright); :}

  | CFG_LETRA_MIENTRAS:c ASSIGN LETRA_NAME:l PIPE num_expr:idx
    {: RESULT = new ConfigInstr("LETRA_MIENTRAS", l, idx.intValue(), cleft, cright); :}

  | CFG_LETRA_SIZE_MIENTRAS:c ASSIGN num_expr:v PIPE num_expr:idx
    {: RESULT = new ConfigInstr("LETRA_SIZE_MIENTRAS", v, idx.intValue(), cleft, cright); :}

  | CFG_COLOR_TEXTO_BLOQUE:c ASSIGN color_value:col PIPE num_expr:idx
    {: RESULT = new ConfigInstr("COLOR_TEXTO_BLOQUE", col, idx.intValue(), cleft, cright); :}

  | CFG_COLOR_BLOQUE:c ASSIGN color_value:col PIPE num_expr:idx
    {: RESULT = new ConfigInstr("COLOR_BLOQUE", col, idx.intValue(), cleft, cright); :}

  | CFG_FIGURA_BLOQUE:c ASSIGN FIGURA_NAME:f PIPE num_expr:idx
    {: RESULT = new ConfigInstr("FIGURA_BLOQUE", f, idx.intValue(), cleft, cright); :}

  | CFG_LETRA_BLOQUE:c ASSIGN LETRA_NAME:l PIPE num_expr:idx
    {: RESULT = new ConfigInstr("LETRA_BLOQUE", l, idx.intValue(), cleft, cright); :}

  | CFG_LETRA_SIZE_BLOQUE:c ASSIGN num_expr:v PIPE num_expr:idx
    {: RESULT = new ConfigInstr("LETRA_SIZE_BLOQUE", v, idx.intValue(), cleft, cright); :}
  ;

/* Color value: rgb (3 num_expr separated by commas) OR hexadecimal */
color_value ::= num_expr:r COMMA num_expr:g COMMA num_expr:b
                {: RESULT = new ColorValue(r.intValue(), g.intValue(), b.intValue(), null); :}
              | HEX_COLOR:h
                {: RESULT = new ColorValue(h); :}
              ;

/* Numeric expression in config section */
num_expr ::= num_expr:l PLUS  num_term:r  {: RESULT = l + r; :}
           | num_expr:l MINUS num_term:r  {: RESULT = l - r; :}
           | num_term:t                   {: RESULT = t; :}
           ;

num_term ::= num_term:l TIMES  num_factor:r {: RESULT = l * r; :}
           | num_term:l DIVIDE num_factor:r {: RESULT = l / r; :}
           | num_factor:f                   {: RESULT = f; :}
           ;

num_factor ::= INTEGER:n            {: RESULT = (double)n; :}
             | DECIMAL:n            {: RESULT = n; :}
             | LPAREN num_expr:e RPAREN {: RESULT = e; :}
             | MINUS num_factor:f   {: RESULT = -f; :} %prec UMINUS
             ;
